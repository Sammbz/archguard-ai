# Copier en .env et remplir. Le .env n'est jamais commité.

# Supabase — onglet Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé service_role : contourne les RLS, à garder strictement côté serveur
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=plans

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Origines autorisées à appeler le service (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000

# Pays des règles réglementaires appliquées : FR, SN, RDC ou GENERIC (défaut).
# Provisoire, en attendant que le pays soit porté par chaque projet.
DEFAULT_COUNTRY=GENERIC

# Nb max de pages analysées par PDF (borne le coût du modèle)
MAX_PDF_PAGES=15

# Optionnel : chemin vers ODA File Converter pour convertir les .dwg en .dxf
# DWG_TO_DXF_CONVERTER=C:\Program Files\ODA\ODAFileConverter.exe
